# Settings for one wall-screen computer. install-kiosk.sh writes this to ~/.config/opsboard/kiosk.env

# Address of the OpsBoard server (no trailing slash).
SERVER=http://192.168.1.50:8080

# left  = this computer drives only the left screen (this month)
# right = this computer drives only the right screen (next month)
# both  = this one computer drives both screens (needs the X11 desktop, see docs/kiosk-setup.md)
MODE=left

# OPSBOARD_KIOSK_TOKEN from the server's settings file. Empty if the server has no password.
TOKEN=

# MODE=both only. Set to 1 if the months come up on the wrong screens.
SWAP_SCREENS=0
# MODE=both only. Set to 1 if touching the left screen acts on the right one.
SWAP_TOUCH=0
# MODE=both with one touchscreen and one plain monitor: which screen has the touch (left or right).
# The left screen shows this month, so the touchscreen normally goes there.
TOUCH_SCREEN=left
# MODE=both only. Text that appears in the touch panels' names in the output of:  xinput list
TOUCH_MATCH=touch

# 1 = really switch the monitors off outside work hours (saves power and backlight life).
# 0 = just show a black page. Use 0 if a tap does not wake your monitors back up.
HARDWARE_SLEEP=1
