# One touchscreen now; change to 2 when adding your second monitor.
MONITOR_COUNT=1
CALENDAR_URL=https://your-calendar-host.your-tailnet.ts.net
# Your first screen uses the left view: current month, with month arrows.
# Linux X11 output name from xrandr --query; do not assume this exact name.
LEFT_OUTPUT=HDMI-1
# Exact USB touch device name from xinput list (quote names containing spaces).
LEFT_TOUCH="replace-with-first-touch-device-name"
# Leave these commented until MONITOR_COUNT=2, then fill in actual names.
# RIGHT_OUTPUT=HDMI-2
# RIGHT_TOUCH="replace-with-second-touch-device-name"
# Desktop logical pixels. Both screens must use this resolution in dual mode.
SCREEN_WIDTH=1920
SCREEN_HEIGHT=1080
