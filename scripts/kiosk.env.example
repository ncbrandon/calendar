# Copy to kiosk.env; use the same reachable address for both windows.
CALENDAR_URL=https://your-calendar-host.your-tailnet.ts.net
# Linux X11 output names from xrandr --query. Do not assume these exact names.
LEFT_OUTPUT=HDMI-1
RIGHT_OUTPUT=HDMI-2
# Set each exact USB touch device name from xinput list.
LEFT_TOUCH=replace-with-left-touch-device-name
RIGHT_TOUCH=replace-with-right-touch-device-name
# Position in desktop logical pixels. Set outputs to matching 1920x1080 first.
SCREEN_WIDTH=1920
SCREEN_HEIGHT=1080
