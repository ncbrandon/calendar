# Copy to .env (Docker) or /etc/opsboard.env (install-server.sh does this for you). Never commit the real file.

# Password for the web page. Leave empty ONLY if the server is reachable from your own network and nowhere else.
OPSBOARD_PASSWORD=change-me

# Lets the wall screens in without typing the password. Any long random string:  openssl rand -hex 24
OPSBOARD_KIOSK_TOKEN=replace-with-a-long-random-string

# Where the database and uploads live.
OPSBOARD_DATA=/var/lib/opsboard

# Your time zone, so "work hours" and "today" are right (Docker only; the install script uses the system clock).
TZ=America/Chicago

# Optional: lets "Read requirements" read a permit PDF with Claude. Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=
# OPSBOARD_AI_MODEL=claude-opus-5-5
