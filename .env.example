# Use scripts/configure.py to generate a private .env with a random password.
ADMIN_PASSWORD=replace-with-at-least-12-characters
# Local host only by default; use Tailscale Serve for private remote HTTPS.
BIND_ADDRESS=127.0.0.1
PORT=8080
# Set to 1 only if all browser access is HTTPS. Local plain HTTP requires 0.
COOKIE_SECURE=0
